{
  "name": "@floken-io/engine",
  "version": "0.0.3",
  "description": "Token-based process engine with Chinese-style approval actions for floken",
  "repository": { "type": "git", "url": "git+https://github.com/floken-io/floken-engine.git" },
  "bugs": { "url": "https://github.com/floken-io/floken-engine/issues" },
  "homepage": "https://github.com/floken-io/floken-engine#readme",
  "author": "MaxLMGC",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=22.12" },
  "packageManager": "pnpm@12.6.0",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./conformance": { "types": "./dist/conformance.d.ts", "default": "./dist/conformance.js" }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": ["dist", "!dist/**/*.map", "README.md", "LICENSE", "CHANGELOG.md"],
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "clean:junk": "node tooling/clean-junk.mjs",
    "prebuild": "node tooling/clean-junk.mjs",
    "build": "tsup",
    "postbuild": "node tooling/clean-junk.mjs",
    "test": "vitest run",
    "verify": "node tooling/verify.mjs",
    "changeset": "changeset",
    "release": "npm run build && npm run verify && changeset publish",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "peerDependencies": {
    "@floken-io/moddle": ">=0.1.0 <0.2.0",
    "@floken-io/feel": ">=0.0.4 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@floken-io/feel": { "optional": true }
  },
  "devDependencies": {
    "@floken-io/moddle": "0.1.0",
    "@floken-io/feel": "0.0.4",
    "@types/node": "^22.20.4",
    "typescript": "5.9.3",
    "tsup": "8.5.1",
    "vitest": "5.0.2",
    "vite": "8.3.1",
    "@changesets/cli": "3.0.3"
  },
  "license": "Apache-2.0"
}
